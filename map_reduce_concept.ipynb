   "source": [
    "documents = {\n",
    "    1: \"Hola mundo hola\",\n",
    "    2: \"Hola MapReduce\"\n",
    "}\n",
    "\n",
    "mapped = []\n",
    "for doc_id, text in documents.items():\n",
    "    mapped.extend(map_fn(doc_id, text))\n",
    "\n",
    "shuffled = shuffle(mapped)\n",
    "\n",
    "results = [reduce_fn(word, counts) for word, counts in shuffled]\n",
    "\n",
    "print(results)\n"
   ]
  }
